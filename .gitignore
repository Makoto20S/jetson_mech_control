# Repository policy: keep the main repository limited to reviewed source,
# configuration, documentation, manifests, and tests.

# Nested supplier repository and supplier/experimental source bundles.
/CubeMars/

# Local AI/session state and temporary workspace material.
/memory/
/.codex/
/.agents/
/.zcode/
/tmp/

# Legacy presentation bundle contains pre-FND-000 assumptions and excluded
# local attachments; retain locally until its claims and references are
# reconciled with the authoritative planning documents.
/presentation/
/company/

# Build, install, test, coverage, and generated output.
/build/
/install/
/log/
/out/
/dist/
/.cache/
/.pytest_cache/
/.colcon/
# The colcon workspace lives under ros2_ws/, so the root-anchored rules above
# do not cover a build run from its default location. Without these three, a
# plain `cd ros2_ws && colcon build` leaves install/setup.bash, CMakeCache.txt
# and copied package.xml files showing as untracked, one `git add -A` away from
# being committed. The supported path sets MECH_OUTPUT_ROOT outside the repo
# (tools/ci/build_workspace.sh); these rules are the backstop for when someone
# forgets, which has now happened more than once.
/ros2_ws/build/
/ros2_ws/install/
/ros2_ws/log/
compile_commands.json
*.coverage
coverage/

# Credentials and local configuration.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Vendor archives, binaries, captures, and large experiment artifacts.
*.pdf
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.exe
*.dll
*.so
*.dylib
*.bin
*.elf
*.hex
*.uf2
*.bag
*.db3
*.mcap
*.rosbag*
*.blf
*.asc
*.pcap
*.pcapng
*.candump
*.log
*.sqlite
*.sqlite3
*.db
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
*.mat
*.npy
*.npz
*.onnx
*.pt
*.pth
*.ckpt
*.engine

# Common generated media/data and editor files.
*.tmp
*.swp
*.swo
*.bak
*.orig
*.pyc
__pycache__/
.DS_Store
Thumbs.db
/.vscode/
/.idea/
/.vs/

# Keep reviewed small test vectors explicit rather than relying on broad rules.
!interfaces/golden_frames/
!interfaces/golden_frames/**
!tests/fixtures/
!tests/fixtures/**
