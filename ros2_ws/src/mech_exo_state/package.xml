<?xml version="1.0"?>
<package format="3">
  <name>mech_exo_state</name>
  <version>0.1.0</version>
  <description>Receive-only PH-EXO motor/IMU state and MuJoCo closed-chain forward kinematics.</description>
  <maintainer email="project-owners@example.invalid">Project Owners</maintainer>
  <license>Internal Research Use - All Rights Reserved</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <!-- MuJoCo/NumPy are restored from manifests/parallel_exo_python.lock.txt. -->
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
